{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "allowJs": true,
    "checkJs": false,

    "outDir": "dist",

    "strict": false,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@sama/*": [
        "./app/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
